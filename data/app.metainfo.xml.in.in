<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application" xmlns="https://www.freedesktop.org/software/appstream">
  <id>@APP_ID@</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>PackageSearch</name>
  <summary>GTK4/Libadwaita app to search and install packages from ALT Linux repositories</summary>
  <description>
    <p>PackageSearch is a GTK4/Libadwaita desktop application for ALT Linux that lets you search, inspect and install packages across the Sisyphus, p11, p10, p9, c10f2 and c9f2 repositories.</p>
  </description>

  <developer id="altlinux.space">
    <name>Vladislav Petrukhin</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <url type="homepage">https://altlinux.space/vladislavpetrukhin/PackageSearch</url>
  <url type="vcs-browser">https://altlinux.space/vladislavpetrukhin/PackageSearch</url>
  <url type="bugtracker">https://altlinux.space/vladislavpetrukhin/PackageSearch/issues</url>

  <provides>
    <binary>packagesearch</binary>
  </provides>

  <releases>
    <release version="@VERSION@" date="2026-06-05">
      <description>
        <p>New release @VERSION@.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1"/>
</component>

