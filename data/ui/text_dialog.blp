using Gtk 4.0;
using Adw 1;

template $TextDialog : Adw.Dialog {
  content-width: 820;
  content-height: 600;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-end-title-buttons: true;
      title-widget: Adw.WindowTitle window_title {};

      [end]
      Gtk.Button copy_button {
        icon-name: "edit-copy-symbolic";
        tooltip-text: _("Copy");
        valign: center;

        styles ["flat"]
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Gtk.ScrolledWindow {
        vexpand: true;

        child: Gtk.TextView text_view {
          editable: false;
          cursor-visible: false;
          monospace: true;
          wrap-mode: word_char;
          top-margin: 8;
          bottom-margin: 8;
          left-margin: 12;
          right-margin: 12;
        };
      };
    };
  };
}
