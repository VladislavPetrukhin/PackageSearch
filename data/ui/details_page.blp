using Gtk 4.0;
using Adw 1;

template $DetailsPage : Adw.NavigationPage {
  title: _("Details");

  child: Gtk.Box {
    orientation: vertical;
    spacing: 0;

    Gtk.Box {
      orientation: horizontal;
      spacing: 8;
      halign: fill;

      Gtk.Button back_btn {
        icon-name: "go-previous-symbolic";
        tooltip-text: _("Back");
        margin-start: 12;
        margin-top: 12;
        margin-bottom: 6;
      }

      Gtk.Label title_lbl {
        css-classes: ["title-1"];
        margin-top: 12;
        margin-end: 12;
        margin-bottom: 6;
        hexpand: true;
        ellipsize: end;
      }
    }

    Adw.ToastOverlay toast_overlay {
      hexpand: true; vexpand: true;

      child: Gtk.Overlay {
        hexpand: true; vexpand: true;

        child: Gtk.ScrolledWindow {
          hexpand: true; vexpand: true;
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;
          propagate-natural-height: true;

          Adw.ClampScrollable {
            maximum-size: 1100;
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            margin-bottom: 12;

            child: Adw.PreferencesPage {
              Adw.PreferencesGroup info_group      { title: _("Info"); }
              Adw.PreferencesGroup bins_group      { title: _("Binaries"); }
              Adw.PreferencesGroup changelog_group { title: _("Changelog"); }
            };
          }
        };

        [overlay]
        Gtk.Revealer loading_revealer {
          transition-type: crossfade;
          reveal-child: false;
          can-target: false;

          child: Gtk.CenterBox {
            valign: center;
            halign: center;

            center-widget: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              halign: center;
              valign: center;

              Gtk.Spinner {
                spinning: true;
                width-request: 40;
                height-request: 40;
              }
              Gtk.Label { label: _("Loading data…"); }
            };
          };
        }
      };
    }
  };
}
