using Gtk 4.0;
using Adw 1;

template $DetailsPage : Adw.NavigationPage {
  title: _("Details");

  child: Adw.ToastOverlay toast_overlay {
    hexpand: true; vexpand: true;

    child: Gtk.Overlay {
      hexpand: true; vexpand: true;

      child: Gtk.ScrolledWindow {
        has-frame: false;
        hexpand: true; vexpand: true;
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        propagate-natural-height: true;

        Adw.Clamp {
          maximum-size: 1500;
          tightening-threshold: 1200;
          margin-start: 0;
          margin-end: 0;
          margin-top: 0;
          margin-bottom: 0;

          child: Adw.PreferencesPage {
            Adw.PreferencesGroup info_group       { title: _("Info"); }
            Adw.PreferencesGroup bins_group       { title: _("Binaries"); }
            Adw.PreferencesGroup deps_group       { title: _("Dependencies"); }
            Adw.PreferencesGroup security_group   { title: _("Security"); }
            Adw.PreferencesGroup versions_group   { title: _("Versions across branches"); }
            Adw.PreferencesGroup downloads_group  { title: _("Downloads"); }
            Adw.PreferencesGroup spec_group       { title: _("Spec file"); }
            Adw.PreferencesGroup changelog_group  { title: _("Changelog"); }
          };
        }
      };

      [overlay]
      Gtk.Revealer loading_revealer {
        transition-type: crossfade;
        reveal-child: false;
        can-target: false;

        child: Gtk.CenterBox {
          valign: center;
          halign: center;

          center-widget: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            halign: center;
            valign: center;

            Adw.Spinner {
              width-request: 40;
              height-request: 40;
            }
            Gtk.Label { label: _("Loading data…"); }
          };
        };
      }
    };
  };
}
