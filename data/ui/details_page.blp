using Gtk 4.0;
using Adw 1;

template $DetailsPage : Adw.NavigationPage {
  title: "Details";

  child: Gtk.Box {
    orientation: vertical;

    Gtk.Button back_btn {
      icon-name: "go-previous-symbolic";
      tooltip-text: "Back";
      halign: start;
      margin-start: 12;
      margin-top: 12;
      margin-bottom: 6;
    }

    Gtk.ScrolledWindow {
      vexpand: true;

      Adw.Clamp {
        maximum-size: 1100;
        margin-start: 12;
        margin-end: 12;
        margin-top: 12;
        margin-bottom: 12;

        Gtk.Box {
          orientation: vertical;
          spacing: 8;

          Gtk.Label title_lbl {
            xalign: 0;
            css-classes: ["title-2"];
          }

          Adw.PreferencesGroup info_group { title: "Info"; }
          Adw.PreferencesGroup bins_group { title: "Binaries"; }
          Adw.PreferencesGroup changelog_group { title: "Changelog"; }
        }
      }
    }
  };
}
