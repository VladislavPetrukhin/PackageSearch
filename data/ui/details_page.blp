using Gtk 4.0;
using Adw 1;

template $DetailsPage : Adw.NavigationPage {
  title: "Details";

  child: Gtk.Box {
    orientation: vertical;
    spacing: 0;

    Gtk.Box {
      orientation: horizontal;
      spacing: 8;
      halign: fill;

      Gtk.Button back_btn {
        icon-name: "go-previous-symbolic";
        tooltip-text: "Back";
        margin-start: 12;
        margin-top: 12;
        margin-bottom: 6;
      }

      Gtk.Label title_lbl {
        css-classes: ["title-1"];
        margin-top: 12;
        margin-end: 12;
        margin-bottom: 6;
        hexpand: true;
        ellipsize: end;
      }
    }

    Gtk.ScrolledWindow {
      vexpand: true;

      Adw.Clamp {
        maximum-size: 1100;
        margin-start: 12;
        margin-end: 12;
        margin-top: 6;
        margin-bottom: 12;

        Gtk.Box {
          orientation: vertical;
          spacing: 8;

          Adw.PreferencesGroup info_group { title: "Info"; }
          Adw.PreferencesGroup bins_group { title: "Binaries"; }
          Adw.PreferencesGroup changelog_group { title: "Changelog"; }
        }
      }
    }
  };
}
