using Gtk 4.0;
using Adw 1;

template $DetailsPage : Adw.NavigationPage {
  title: _("Details");
  tag: "details";

  child: Adw.ToastOverlay toast_overlay {
      child: Adw.ToolbarView toolbar {
        [top]
        Adw.HeaderBar header_bar {
          show-end-title-buttons: true;

          title-widget: Adw.WindowTitle header_title {
            title: _("Details");
          };
        }

        [top]
        Adw.Banner banner {
          revealed: false;
        }

        content: Gtk.Box content_box {
          orientation: vertical;
          spacing: 0;

          Gtk.Box hero_frame {
            margin-start: 18;
            margin-end: 18;
            margin-top: 10;
            margin-bottom: 6;

            Gtk.Box hero_box {
              hexpand: true;
              orientation: horizontal;
              spacing: 16;
              styles ["pkg-hero"]

              Gtk.Image hero_icon {
                icon-name: "package-x-generic-symbolic";
                pixel-size: 48;
                valign: center;
                styles ["pkg-icon"]
              }

              Gtk.Box hero_center {
                orientation: vertical;
                spacing: 4;
                hexpand: true;
                valign: center;

                Gtk.Label hero_name {
                  xalign: 0.0;
                  halign: start;
                  hexpand: true;
                  ellipsize: end;
                  label: "";
                  styles ["title-2", "pkg-name"]
                }

                Gtk.Label hero_summary {
                  xalign: 0.0;
                  halign: start;
                  wrap: true;
                  wrap-mode: word_char;
                  max-width-chars: 40;
                  lines: 2;
                  ellipsize: end;
                  label: "";
                  styles ["pkg-summary"]
                }

                Gtk.Box hero_badges {
                  orientation: horizontal;
                  spacing: 6;
                  halign: start;
                  margin-top: 4;
                }
              }

              Gtk.Box hero_actions {
                orientation: horizontal;
                spacing: 8;
                valign: center;
              }
            }
          }

          Adw.ViewStack view_stack {
            vexpand: true;

            Adw.ViewStackPage overview_page {
              name: "overview";
              title: _("Overview");
              icon-name: "dialog-information-symbolic";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Adw.Clamp {
                  maximum-size: 1100;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 12;

                  child: Adw.PreferencesGroup info_group {
                    title: _("Info");
                  };
                };
              };
            }

            Adw.ViewStackPage binaries_page {
              name: "binaries";
              title: _("Binaries");
              icon-name: "package-x-generic-symbolic";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Adw.Clamp {
                  maximum-size: 1100;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 12;

                  child: Adw.PreferencesGroup bins_group {
                    title: _("Binary packages");
                  };
                };
              };
            }

            Adw.ViewStackPage deps_page {
              name: "dependencies";
              title: _("Dependencies");
              icon-name: "emblem-synchronizing-symbolic";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Adw.Clamp {
                  maximum-size: 1100;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 12;

                  child: Adw.PreferencesGroup deps_group {
                    title: _("Dependencies");
                  };
                };
              };
            }

            Adw.ViewStackPage security_page {
              name: "security";
              title: _("Security");
              icon-name: "security-medium-symbolic";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Adw.Clamp {
                  maximum-size: 1100;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 12;

                  child: Adw.PreferencesGroup security_group {
                    title: _("Security");
                  };
                };
              };
            }

            Adw.ViewStackPage versions_page {
              name: "versions";
              title: _("Versions");
              icon-name: "view-list-symbolic";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Adw.Clamp {
                  maximum-size: 1100;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 12;

                  child: Adw.PreferencesGroup versions_group {
                    title: _("Versions across branches");
                  };
                };
              };
            }

            Adw.ViewStackPage downloads_page {
              name: "downloads";
              title: _("Downloads");
              icon-name: "folder-download-symbolic";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Adw.Clamp {
                  maximum-size: 1100;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 12;

                  child: Adw.PreferencesGroup downloads_group {
                    title: _("Downloads");
                  };
                };
              };
            }

            Adw.ViewStackPage spec_page {
              name: "spec";
              title: _("Spec");
              icon-name: "text-x-generic-symbolic";

              child: Gtk.Box spec_box {
                orientation: vertical;
                spacing: 0;

                Adw.Banner spec_banner {
                  revealed: false;
                }

                Gtk.Stack spec_stack {
                  vexpand: true;
                  transition-type: crossfade;

                  Gtk.StackPage {
                    name: "loading";

                    child: Gtk.CenterBox {
                      valign: center;
                      halign: center;

                      center-widget: Gtk.Box {
                        orientation: vertical;
                        spacing: 10;
                        halign: center;

                        Gtk.Spinner {
                          spinning: true;
                          width-request: 36;
                          height-request: 36;
                        }

                        Gtk.Label {
                          label: _("Loading spec file…");
                        }
                      };
                    };
                  }

                  Gtk.StackPage {
                    name: "content";

                    child: Gtk.ScrolledWindow {
                      hscrollbar-policy: automatic;
                      vscrollbar-policy: automatic;
                      vexpand: true;

                      child: Gtk.TextView spec_view {
                        editable: false;
                        cursor-visible: false;
                        monospace: true;
                        wrap-mode: none;
                        top-margin: 10;
                        bottom-margin: 10;
                        left-margin: 14;
                        right-margin: 14;
                        styles ["spec-view"]
                      };
                    };
                  }
                }
              };
            }

            Adw.ViewStackPage changelog_page {
              name: "changelog";
              title: _("Changelog");
              icon-name: "document-edit-symbolic";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Adw.Clamp {
                  maximum-size: 1100;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 12;

                  child: Adw.PreferencesGroup changelog_group {
                    title: _("Changelog");
                  };
                };
              };
            }
          }
        };

        [bottom]
        Adw.ViewSwitcher switcher_bar {
          stack: view_stack;
          policy: narrow;
          halign: center;
          styles ["bottom-switcher"]
        }
      };
    };
}
