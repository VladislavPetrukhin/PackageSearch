using Gtk 4.0;
using Adw 1;

template $SearchPage : Adw.NavigationPage {
  title: _("Search");
  tag: "search";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar search_header {
      [start]
      Gtk.DropDown mode_dropdown {
        valign: center;
        tooltip-text: _("Search mode");
      }

      title-widget: Gtk.SearchEntry search_entry {
        placeholder-text: _("Type a package name…");
        activates-default: true;
        width-request: 360;
        hexpand: true;
        valign: center;
      };

      [end]
      Gtk.MenuButton menu_btn {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main menu");
        menu-model: menu_main;
        valign: center;
        primary: true;
      }

      [end]
      Gtk.MenuButton history_btn {
        icon-name: "document-open-recent-symbolic";
        tooltip-text: _("Recent searches");
        valign: center;
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Adw.ViewStack content_stack {
        vexpand: true;

        Adw.ViewStackPage {
          name: "idle";
          child: Adw.StatusPage idle_status {
            icon-name: "system-search-symbolic";
            title: _("Search packages");
            description: _("Start typing a source package name, then pick it from the results.");
            styles ["tinted-status"]
          };
        }

        Adw.ViewStackPage {
          name: "loading";
          child: Gtk.CenterBox {
            valign: center;
            halign: center;

            center-widget: Gtk.Spinner {
              spinning: true;
              width-request: 42;
              height-request: 42;
            };
          };
        }

        Adw.ViewStackPage {
          name: "results";
          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;
            vexpand: true;

            child: Adw.Clamp {
              maximum-size: 800;
              margin-start: 12;
              margin-end: 12;
              margin-top: 12;
              margin-bottom: 12;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 12;

                Gtk.Label results_header {
                  xalign: 0.0;
                  halign: start;
                  margin-start: 4;
                  styles ["dim-label"]
                }

                Gtk.ListBox results_list {
                  selection-mode: none;
                  valign: start;
                  styles ["cards-list"]
                }
              };
            };
          };
        }

        Adw.ViewStackPage {
          name: "empty";
          child: Adw.StatusPage empty_status {
            icon-name: "edit-find-replace-symbolic";
            title: _("No results");
            description: _("Try refining your query or choose another search mode.");
            styles ["tinted-status"]

            child: Gtk.Box suggestions_box {
              orientation: vertical;
              halign: center;
              spacing: 6;
            };
          };
        }

        Adw.ViewStackPage {
          name: "error";
          child: Adw.StatusPage {
            icon-name: "network-error-symbolic";
            title: _("Connection error");
            description: _("Failed to fetch data. Check your connection and try again.");

            child: Gtk.Button retry_btn {
              label: _("Retry");
              halign: center;
              styles ["pill", "suggested-action"]
            };
          };
        }
      };
    };
  };
}

menu menu_main {
  section {
    item {
      label: _("Clear search history");
      action: "win.clear-history";
    }

    item {
      label: _("About PackageSearch");
      action: "win.about";
    }
  }
}
