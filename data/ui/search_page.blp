using Gtk 4.0;
using Adw 1;

template $SearchPage : Adw.NavigationPage {
  title: _("Search");

  child: Adw.ToastOverlay toast_overlay {
    child: Adw.ViewStack content_stack {
      vexpand: true;

      Adw.ViewStackPage {
        name: "idle";
        title: _("Search");
        child: Adw.StatusPage {
          icon-name: "system-search-symbolic";
          title: _("Search packages");
          description: _("Start typing a source package name, then pick it from the results.");
        };
      }

      Adw.ViewStackPage {
        name: "loading";
        title: _("Loading");
        child: Gtk.CenterBox {
          valign: center;
          halign: center;
          center-widget: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            halign: center;
            valign: center;

            Adw.Spinner { width-request: 42; height-request: 42; }
            Gtk.Label { label: _("Loading results…"); }
          };
        };
      }

      Adw.ViewStackPage {
        name: "results";
        title: _("Results");
        child: Gtk.ScrolledWindow results_scroller {
          css-classes: ["results-scroll"];
          has-frame: false;
          vexpand: true;
          hscrollbar-policy: never;

          Adw.ClampScrollable {
            maximum-size: 1500;
            tightening-threshold: 1200;
            margin-start: 12;
            margin-end: 12;
            margin-top: 12;
            margin-bottom: 12;

            Gtk.ListView list_view {
              margin-start: 96;
              margin-end: 96;
            }
          }
        };
      }

      Adw.ViewStackPage {
        name: "empty";
        title: _("No results");
        child: Adw.StatusPage {
          icon-name: "edit-find-replace-symbolic";
          title: _("No results");
          description: _("Try refining your query or choose another branch.");
        };
      }

      Adw.ViewStackPage {
        name: "error";
        title: _("Error");
        child: Adw.StatusPage {
          icon-name: "dialog-error-symbolic";
          title: _("Error");
          description: _("Failed to fetch data. Check your connection and package name.");
        };
      }
    };
  };
}
