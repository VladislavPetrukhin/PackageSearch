using Gtk 4.0;
using Adw 1;

template $VersionCompareDialog : Adw.Dialog {
  content-width: 820;
  content-height: 640;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-end-title-buttons: true;
      title-widget: Adw.WindowTitle window_title {};

      [start]
      Gtk.ToggleButton only_diff {
        label: _("Only differences");
        active: true;
        valign: center;
      }
    }

    content: Adw.PreferencesPage page {};
  };
}
