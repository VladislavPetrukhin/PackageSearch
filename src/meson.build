src = files(
  'application.vala',
  'window.vala',
  'views/find.vala',
  'views/util.vala',
  'views/lazy_expander_row.vala',
  'views/install_progress_dialog.vala',
  'views/install_controller.vala',
  'views/text_dialog.vala',
  'views/version_compare_dialog.vala',
  'views/package_hero.vala',
  'views/source_result_row.vala',
  'views/task_result_row.vala',
  'views/history_popover.vala',
  'views/search_page.vala',
  'views/details_page.vala',
  'views/maintainer_page.vala',
  'views/dependency_graph_page.vala',
  'views/graph_node.vala',
  'views/graph_renderer.vala',
  'views/task_details_page.vala',
  'views/security_rows.vala',
  'data/models.vala',
  'data/search_text.vala',
  'data/validation.vala',
  'data/repo_api_base.vala',
  'data/search_api.vala',
  'data/package_api.vala',
  'data/dependency_api.vala',
  'data/security_api.vala',
  'data/task_api.vala',
  'data/download_api.vala',
  'business/version_compare.vala',
  'business/text_diff.vala',
  'business/package_manager.vala',
)

lib_testable = static_library(
  'testable',
  sources: [
    'data/models.vala',
    'data/search_text.vala',
    'data/validation.vala',
    'business/version_compare.vala',
    'business/text_diff.vala',
    'business/package_manager.vala',
  ],
  dependencies: [
    dependency('gio-2.0'),
    gee_dep,
  ],
  vala_args: [
    '--target-glib=2.74',
    '--pkg=gio-2.0',
    '--pkg=gee-0.8',
  ],
  install: false,
)

lib_testable_dep = declare_dependency(
  link_with:           lib_testable,
  include_directories: include_directories('.'),
)
